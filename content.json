    "faq": [
      {
        "q": {
          "en": "What should I include in an enquiry?",
          "ar": "ماذا أذكر في الاستفسار؟"
        },
        "a": {
          "en": "Product name, destination country, estimated quantity and packaging preference. A preferred trade term and any specification help us respond faster.",
          "ar": "اسم المنتج وبلد الوجهة والكمية التقديرية وتفضيل التعبئة. ويساعدنا شرط التجارة المفضل وأي مواصفات على الرد بشكل أسرع."
        }
      },
      {
        "q": {
          "en": "Can specifications be tailored?",
          "ar": "هل يمكن تخصيص المواصفات؟"
        },
        "a": {
          "en": "Yes. Varieties, grades, packaging, order quantities and availability can be tailored to your market and purchase requirements, subject to availability.",
          "ar": "نعم. يمكن تخصيص الأصناف والدرجات والتعبئة وكميات الطلب والتوفر بما يناسب سوقك ومتطلبات الشراء، حسب التوفر."
        }
      },
      {
        "q": {
          "en": "What is the minimum order quantity?",
          "ar": "ما الحد الأدنى للطلب؟"
        },
        "a": {
          "en": "It depends on the product, packaging and shipping method, so we confirm it for each enquiry.",
          "ar": "يعتمد على المنتج والتعبئة وطريقة الشحن، لذلك نؤكده لكل استفسار."
        }
      },
      {
        "q": {
          "en": "Which documents do you provide?",
          "ar": "ما المستندات التي توفرونها؟"
        },
        "a": {
          "en": "Documents are prepared for the specific order. The set depends on the product and destination, so tell us your import requirements early.",
          "ar": "تُعدّ المستندات للطلب المحدد. وتعتمد المجموعة على المنتج والوجهة، لذا أخبرنا بمتطلبات الاستيراد لديك مبكرًا."
        }
      },
      {
        "q": {
          "en": "Which trade terms are available?",
          "ar": "ما شروط التجارة المتاحة؟"
        },
        "a": {
          "en": "EXW, FOB, CFR and CIF, or leave it open and we will advise on the best fit.",
          "ar": "EXW وFOB وCFR وCIF، أو اتركه مفتوحًا وسننصحك بالأنسب."
        }
      },
      {
        "q": {
          "en": "Do you work with buyers worldwide?",
          "ar": "هل تتعاملون مع مشترين حول العالم؟"
        },
        "a": {
          "en": "We work with international buyers. We confirm shipping options for each destination when we prepare your proposal.",
          "ar": "نعمل مع مشترين دوليين، ونؤكد خيارات الشحن لكل وجهة عند إعداد عرضك."
        }
      }
