    "terms": [
      {
        "id": "EXW",
        "title": {
          "en": "Ex Works",
          "ar": "تسليم أرض المصنع"
        },
        "text": {
          "en": "The seller makes the goods available at its premises. The buyer arranges export clearance, transport, freight and everything after.",
          "ar": "يتيح البائع البضاعة في مقره. ويتولى المشتري التخليص التصديري والنقل والشحن وكل ما بعده."
        },
        "seller": [
          0
        ],
        "insurance": false
      },
      {
        "id": "FOB",
        "title": {
          "en": "Free On Board",
          "ar": "تسليم ظهر السفينة"
        },
        "text": {
          "en": "The seller clears the goods for export and loads them on the vessel at the port of shipment. The buyer arranges freight and everything after.",
          "ar": "يخلّص البائع البضاعة للتصدير ويحمّلها على السفينة في ميناء الشحن. ويتولى المشتري الشحن وكل ما بعده."
        },
        "seller": [
          0,
          1
        ],
        "insurance": false
      },
      {
        "id": "CFR",
        "title": {
          "en": "Cost and Freight",
          "ar": "التكلفة والشحن"
        },
        "text": {
          "en": "The seller pays the sea freight to the destination port. Risk passes to the buyer once the goods are loaded on the vessel.",
          "ar": "يدفع البائع أجرة الشحن البحري حتى ميناء الوصول. وتنتقل المخاطر إلى المشتري عند تحميل البضاعة على السفينة."
        },
        "seller": [
          0,
          1,
          2
        ],
        "insurance": false
      },
      {
        "id": "CIF",
        "title": {
          "en": "Cost, Insurance and Freight",
          "ar": "التكلفة والتأمين والشحن"
        },
        "text": {
          "en": "As CFR, with the seller also arranging minimum insurance to the destination port. Risk still passes to the buyer at loading.",
          "ar": "مثل CFR، ويرتب البائع أيضًا الحد الأدنى من التأمين حتى ميناء الوصول. وتنتقل المخاطر إلى المشتري عند التحميل."
        },
        "seller": [
          0,
          1,
          2
        ],
        "insurance": true
      }
    ]
